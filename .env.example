# Required. Bot token from https://discord.com/developers -> your app -> Bot.
DISCORD_BOT_TOKEN=

# Strongly recommended. Slash commands registered against one guild appear
# immediately; registered globally they take up to an hour to propagate.
# Right-click your server -> Copy Server ID (needs Developer Mode on).
DISCORD_GUILD_ID=

# Optional. Name or path of the yt-dlp executable. Default: yt-dlp (from PATH).
YTDLP_PATH=

# Optional. Extra flags for every yt-dlp call, split on whitespace. Empty is the
# right default: deno on PATH is all yt-dlp needs. This is the escape hatch for
# when YouTube changes something:
#   --cookies-from-browser firefox    get past "confirm you're not a bot"
#   --source-address 0.0.0.0          force IPv4 if your ISP's v6 is blocked
YTDLP_EXTRA_ARGS=

# Optional. Seconds to sit in an empty-queue voice channel before leaving.
# Default: 300.
IDLE_TIMEOUT_SECONDS=

# Optional. Log filter, tracing-subscriber syntax.
# Default: boomtsy=info,songbird=warn,serenity=warn
RUST_LOG=
